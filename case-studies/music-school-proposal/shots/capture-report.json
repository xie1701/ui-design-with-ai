    },
    {
      "tag": "BUTTON",
      "text": "01每节课后，老师的点评和嘱咐，一字",
      "outline": "2px solid"
    },
    {
      "tag": "BUTTON",
      "text": "02老师布置的练习，孩子完成得怎么样",
      "outline": "2px solid"
    },
    {
      "tag": "BUTTON",
      "text": "03孩子在家练琴的视频，传上来，老师",
      "outline": "2px solid"
    },
    {
      "tag": "BUTTON",
      "text": "04每一节课后，孩子自己对着手机说三",
      "outline": "2px solid"
    },
    {
      "tag": "BUTTON",
      "text": "按住三秒",
      "outline": "2px solid"
    },
    {
      "tag": "BUTTON",
      "text": "哼一段旋律",
      "outline": "2px solid"
    },
    {
      "tag": "BUTTON",
      "text": "描述今天的心情",
      "outline": "2px solid"
    },
